<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>La Teca del Giardiniere</display-name>

    <!-- Welcome File List: Specifica quali file vengono serviti quando si accede alla root dell'applicazione -->
    <welcome-file-list>
        <welcome-file>homepage.jsp</welcome-file>
        <welcome-file>index.html</welcome-file>
        <welcome-file>index.htm</welcome-file>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>default.html</welcome-file>
        <welcome-file>default.htm</welcome-file>
        <welcome-file>default.jsp</welcome-file>
    </welcome-file-list>

    <!-- Servlet Definitions -->
    <!-- Qui definirai ogni servlet che utilizzi nell'applicazione -->

    <!-- Servlet per il Login -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.la_teca_del_giardiniere.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/LoginServlet</url-pattern>
    </servlet-mapping>

    <!-- Servlet per la Registrazione -->
    <servlet>
        <servlet-name>RegistrazioneServlet</servlet-name>
        <servlet-class>com.la_teca_del_giardiniere.RegistrazioneServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegistrazioneServlet</servlet-name>
        <url-pattern>/RegistrazioneServlet</url-pattern>
    </servlet-mapping>

    <!-- Servlet per visualizzare i dettagli dell'utente (proprio o da admin) -->
    <servlet>
        <servlet-name>DettaglioUtenteServlet</servlet-name>
        <servlet-class>com.la_teca_del_giardiniere.DettaglioUtenteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DettaglioUtenteServlet</servlet-name>
        <url-pattern>/DettaglioUtenteServlet</url-pattern>
    </servlet-mapping>

    <!-- Servlet per modificare un utente -->
    <servlet>
        <servlet-name>ModificaUtenteServlet</servlet-name>
        <servlet-class>com.la_teca_del_giardiniere.ModificaUtenteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ModificaUtenteServlet</servlet-name>
        <url-pattern>/ModificaUtenteServlet</url-pattern>
    </servlet-mapping>

    <!-- Servlet per eliminare un utente (probabilmente solo per admin) -->
    <servlet>
        <servlet-name>EliminaUtenteServlet</servlet-name>
        <servlet-class>com.la_teca_del_giardiniere.EliminaUtenteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EliminaUtenteServlet</servlet-name>
        <url-pattern>/EliminaUtenteServlet</url-pattern>
    </servlet-mapping>

    <!-- Servlet per il Logout -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.la_teca_del_giardiniere.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/LogoutServlet</url-pattern>
    </servlet-mapping>

    <!-- Piante Servlet -->
    <servlet>
        <servlet-name>PianteServlet</servlet-name>
        <servlet-class>com.la_teca_del_giardiniere.PianteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PianteServlet</servlet-name>
        <url-pattern>/PianteServlet</url-pattern>
    </servlet-mapping>

    <!-- Visualizza Utenti Servlet -->
    <servlet>
        <servlet-name>VisualizzaUtentiServlet</servlet-name>
        <servlet-class>com.la_teca_del_giardiniere.VisualizzaUtentiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VisualizzaUtentiServlet</servlet-name>
        <url-pattern>/VisualizzaUtentiServlet</url-pattern>
    </servlet-mapping>

    <!-- Carrello Servlet -->
    <servlet>
        <servlet-name>CarrelloServlet</servlet-name>
        <servlet-class>com.la_teca_del_giardiniere.CarrelloServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CarrelloServlet</servlet-name>
        <url-pattern>/CarrelloServlet</url-pattern>
    </servlet-mapping>

    <!-- Aggiungi Al Carrello Servlet -->
    <servlet>
        <servlet-name>AggiungiAlCarrelloServlet</servlet-name>
        <servlet-class>com.la_teca_del_giardiniere.AggiungiAlCarrelloServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AggiungiAlCarrelloServlet</servlet-name>
        <url-pattern>/AggiungiAlCarrelloServlet</url-pattern>
    </servlet-mapping>

    <!-- Rimuovi Dal Carrello Servlet -->
    <servlet>
        <servlet-name>RimuoviDalCarrelloServlet</servlet-name>
        <servlet-class>com.la_teca_del_giardiniere.RimuoviDalCarrelloServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RimuoviDalCarrelloServlet</servlet-name>
        <url-pattern>/RimuoviDalCarrelloServlet</url-pattern>
    </servlet-mapping>

    <!-- Aggiorna Quantita Carrello Servlet -->
    <servlet>
        <servlet-name>AggiornaQuantitaCarrelloServlet</servlet-name>
        <servlet-class>com.la_teca_del_giardiniere.AggiornaQuantitaCarrelloServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AggiornaQuantitaCarrelloServlet</servlet-name>
        <url-pattern>/AggiornaQuantitaCarrelloServlet</url-pattern>
    </servlet-mapping>

    <!-- Dettaglio Ordine Servlet -->
    <servlet>
        <servlet-name>DettaglioOrdineServlet</servlet-name>
        <servlet-class>com.la_teca_del_giardiniere.DettaglioOrdineServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DettaglioOrdineServlet</servlet-name>
        <url-pattern>/DettaglioOrdineServlet</url-pattern>
    </servlet-mapping>

    <!-- Processa Checkout Servlet -->
    <servlet>
        <servlet-name>ProcessaCheckoutServlet</servlet-name>
        <servlet-class>com.la_teca_del_giardiniere.ProcessaCheckoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProcessaCheckoutServlet</servlet-name>
        <url-pattern>/ProcessaCheckoutServlet</url-pattern>
    </servlet-mapping>

    <!-- Filter Definitions -->
    <!-- Qui definirai i filtri per la sicurezza, la codifica, ecc. -->

    <!-- Filtro per la codifica dei caratteri (UTF-8) -->
    <filter>
        <filter-name>SetCharacterEncodingFilter</filter-name>
        <filter-class>org.apache.catalina.filters.SetCharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
        <init-param>
            <param-name>ignore</param-name>
            <param-value>true</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>SetCharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Filtro di Autenticazione (UserAuthFilter) -->
    <!-- Questo filtro controllerà se l'utente è autenticato per accedere a risorse protette -->
    <filter>
        <filter-name>UserAuthFilter</filter-name>
        <filter-class>com.la_teca_del_giardiniere.filters.UserAuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>UserAuthFilter</filter-name>
        <url-pattern>/dettaglioutente.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>UserAuthFilter</filter-name>
        <url-pattern>/ModificaUtenteServlet</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>UserAuthFilter</filter-name>
        <url-pattern>/VisualizzaCarrelloServlet</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>UserAuthFilter</filter-name>
        <url-pattern>/ProcessaCheckoutServlet</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>UserAuthFilter</filter-name>
        <url-pattern>/utente.jsp</url-pattern> <!-- Se hai una pagina profilo generica per l'utente -->
    </filter-mapping>
    <!-- Aggiungi qui altre URL-pattern che richiedono l'autenticazione -->

    <!-- Filtro di Autorizzazione Admin (AdminAuthFilter) -->
    <!-- Questo filtro controllerà se l'utente autenticato è un amministratore -->
    <filter>
        <filter-name>AdminAuthFilter</filter-name>
        <filter-class>com.la_teca_del_giardiniere.admin.AdminAuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminAuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern> <!-- Protegge l'intera cartella admin -->
    </filter-mapping>
    <filter-mapping>
        <filter-name>AdminAuthFilter</filter-name>
        <url-pattern>/EliminaUtenteServlet</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AdminAuthFilter</filter-name>
        <url-pattern>/ModificaAccessorioServlet</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AdminAuthFilter</filter-name>
        <url-pattern>/ModificaPianteServlet</url-pattern>
    </filter-mapping>
    <!-- Aggiungi qui altre URL-pattern che richiedono privilegi di admin -->

    <!-- Error Page Configuration -->
    <error-page>
        <error-code>404</error-code>
        <location>/error_pages/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error_pages/500.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/error_pages/general_error.jsp</location>
    </error-page>

    <!-- Session Configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>